[Unit]
Description=Manually refresh Neon production and reset test with a preserved rollback branch
RequiresMountsFor=/mnt/zspace-xzs-backup
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/xzs/neon-production-refresh.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apps/gesp-csp-quiz
EnvironmentFile=/etc/xzs/neon-production-refresh.env
Environment=XZS_NEON_DR_SECRET_FILE=/etc/xzs/neon-production-refresh.env
Environment=XZS_NEON_DR_REFRESH_CONFIRM=REFRESH_NEON_PRODUCTION
Environment=XZS_NEON_DR_STATE_FILE=/var/lib/xzs-neon-dr-refresh/last-success.json
Environment=XZS_NEON_TEST_SECRET_FILE=/etc/xzs/neon-production-refresh.env
Environment=XZS_NEON_TEST_RESET_STATE_FILE=/var/lib/xzs-neon-dr-refresh/test-reset-state.json
ExecStart=/usr/bin/nice -n 10 /usr/bin/ionice -c2 -n7 /opt/apps/gesp-csp-quiz/ops/refresh-neon-dr-from-latest.sh
ExecStart=/usr/bin/nice -n 10 /usr/bin/ionice -c2 -n7 /usr/bin/python3 /opt/apps/gesp-csp-quiz/ops/reset-neon-test-from-production.py --preserve-current
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=xzs-neon-dr-refresh
StateDirectoryMode=0700
TimeoutStartSec=90min

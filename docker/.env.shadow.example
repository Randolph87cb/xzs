# This file is a template. Copy it to /opt/apps/gesp-csp-quiz/.env.shadow,
# replace every placeholder, and keep the real file out of Git.
COMPOSE_PROJECT_NAME=xzs-shadow
XZS_POSTGRES_CONTAINER_NAME=xzs-postgres-shadow
XZS_APP_CONTAINER_NAME=xzs-app-shadow
XZS_RESTART_POLICY=unless-stopped

XZS_IMAGE=crpi-s5bag0a5r8vcgncq.cn-hangzhou.personal.cr.aliyuncs.com/randolph87/gesp-csp-quiz:latest
XZS_HOST_BIND=127.0.0.1
XZS_HOST_PORT=18000
XZS_LOG_DIR=./log-shadow

XZS_POSTGRES_IMAGE=postgres:18.4-bookworm
XZS_POSTGRES_DB=xzs_shadow
XZS_POSTGRES_USER=xzs_shadow
XZS_POSTGRES_PASSWORD=<shadow-postgres-strong-password>
XZS_POSTGRES_DATA_DIR=<usb-ssd-mount>/xzs/postgres-shadow/data
XZS_POSTGRES_MAX_CONNECTIONS=15

SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Use the same stable production value only when encrypted AI configuration
# must be included in the shadow smoke test. Never commit the real value.
XZS_AI_CONFIG_SECRET=<shadow-or-production-secret-32-chars-or-longer>

JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:+UseSerialGC
SERVER_UNDERTOW_IO_THREADS=2
SERVER_UNDERTOW_WORKER_THREADS=8
SERVER_UNDERTOW_BUFFER_SIZE=512
SERVER_UNDERTOW_DIRECT_BUFFERS=false

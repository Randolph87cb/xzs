# Dedicated secret/config for the Raspberry Pi Neon production refresh and the
# subsequent Neon test branch reset. Copy this file to:
#   docker/.env.neon-production-refresh
# The real file is ignored by Git. The deployment entry installs it as:
#   /etc/xzs/neon-production-refresh.env (root:root 0600)
# Do not reuse docker/.env.production or include application-only secrets here.

# Direct, non-pooled Neon production target. The fingerprint is sha256 of:
# lowercase-direct-host|port|database|role
NEON_DR_DIRECT_URL=postgresql://<production-role>:<production-password>@<production-direct-host>/<database>?sslmode=require
XZS_NEON_PRODUCTION_TARGET_FINGERPRINT=sha256:<approved-production-target-fingerprint>

# Mandatory deny target for the Fly/local Neon test endpoint, calculated with
# the same host|port|database|role rule.
XZS_NEON_TEST_TARGET_FINGERPRINT=sha256:<known-test-target-fingerprint>
XZS_NEON_DR_MAX_BACKUP_AGE_SECONDS=10800

# Neon API and test endpoint used only after the production refresh succeeds.
NEON_API_KEY=<project-scoped-neon-api-key>
NEON_PROJECT_ID=<neon-project-id>
NEON_SOURCE_BRANCH_NAME=production
NEON_TARGET_BRANCH_NAME=test
NEON_EXPECTED_TEST_ENDPOINT_ID=<test-read-write-endpoint-id>
NEON_TEST_DIRECT_URL=postgresql://<test-role>:<test-password>@<test-direct-host>/<database>?sslmode=require
NEON_TEST_FLY_BASE_URL=https://gesp-csp-quiz.fly.dev
NEON_TEST_PRESERVE_PREFIX=test-pre-reset-

# The backup project must be below this exact mounted filesystem. A local root
# filesystem is rejected even if the directory exists.
XZS_BACKUP_ROOT=/mnt/zspace-xzs-backup/gesp-csp-quiz
XZS_BACKUP_EXPECTED_MOUNT_TARGET=/mnt/zspace-xzs-backup
XZS_BACKUP_EXPECTED_FSTYPE=cifs
XZS_POSTGRES_OPS_LOCK_FILE=/run/lock/xzs-postgres-ops.lock
XZS_POSTGRES_IMAGE=postgres:18.4-bookworm

# Conservative operation and validation limits.
XZS_NEON_TEST_MAX_PRODUCTION_SUCCESS_AGE_SECONDS=14400
XZS_NEON_TEST_OPERATION_TIMEOUT_SECONDS=600
XZS_NEON_TEST_OPERATION_POLL_SECONDS=5
XZS_NEON_API_TIMEOUT_SECONDS=20
XZS_NEON_API_RETRY_ATTEMPTS=5
XZS_NEON_API_RETRY_DELAY_SECONDS=2
XZS_NEON_TEST_VALIDATION_ATTEMPTS=20
XZS_NEON_TEST_VALIDATION_RETRY_SECONDS=3

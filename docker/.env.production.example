XZS_IMAGE=crpi-s5bag0a5r8vcgncq.cn-hangzhou.personal.cr.aliyuncs.com/randolph87/gesp-csp-quiz:latest
XZS_HOST_PORT=8000

# Raspberry Pi production uses this local PostgreSQL service. The data directory
# must be an explicit USB SSD path; do not use the SD card or the NAS mount.
XZS_POSTGRES_IMAGE=postgres:18.4-bookworm
XZS_POSTGRES_DB=xzs
XZS_POSTGRES_USER=xzs
XZS_POSTGRES_PASSWORD=<local-postgres-strong-password>
XZS_POSTGRES_DATA_DIR=<usb-ssd-mount>/xzs/postgres/data
XZS_POSTGRES_MAX_CONNECTIONS=30

# Backup staging must be on the USB SSD. The NAS project root is the only
# location where the retention scripts are allowed to remove backup families.
XZS_BACKUP_STAGING_DIR=<usb-ssd-mount>/xzs/backup-staging
XZS_BACKUP_ROOT=/mnt/zspace-xzs-backup/gesp-csp-quiz
XZS_BACKUP_STAGING_MAX_USE_PERCENT=80

# Neon production refresh and Neon test reset do not read this application
# environment. Keep their URLs, API key, target fingerprints and mount identity
# only in the ignored docker/.env.neon-production-refresh file, created from
# docker/.env.neon-production-refresh.example and deployed root:root 0600.

SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Keep this value stable. Rotating it requires re-saving encrypted AI API keys.
XZS_AI_CONFIG_SECRET=<production-secret-32-chars-or-longer>

JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+UseSerialGC
SERVER_UNDERTOW_IO_THREADS=2
SERVER_UNDERTOW_WORKER_THREADS=16
SERVER_UNDERTOW_BUFFER_SIZE=512
SERVER_UNDERTOW_DIRECT_BUFFERS=false
